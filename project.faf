faf_version: "3.0"
project:
  name: rust-mcp-census
  goal: Count, each week, every server in the official MCP Registry whose latest version lists a cargo (crates.io) package.
  main_language: Python
  type: cli  # src/census.py is run as a command (python3 src/census.py [--readme])
commands:
  run: python3 src/census.py — collect today's snapshot into data/, then rebuild README.md
  readme: python3 src/census.py --readme — rebuild README.md from the snapshots already in data/
key_files:
  - src/census.py — the whole census: registry crawl, GitHub owner and stars, data/ snapshot, README.md writer
  - data/ — one snapshot per day, YYYY-MM-DD.json and YYYY-MM-DD.csv
  - README.md — generated output of src/census.py (readme())
  - .github/workflows/weekly.yml — Mondays 06:00 UTC run that opens a census/<date> PR
stack:
  frontend: slotignored
  css_framework: slotignored
  ui_library: slotignored
  state_management: slotignored
  backend: slotignored
  api_type: slotignored
  runtime: slotignored
  database: slotignored
  connection: slotignored
  hosting: GitHub — the repo's README.md is the published census
  build: No build step — Python 3 standard library; gh supplies owner and stars
  cicd: GitHub Actions
  monorepo_tool: slotignored
  package_manager: slotignored
  workspaces: slotignored
  admin: slotignored
  cache: slotignored
  search: slotignored
  storage: slotignored
human_context:
  who: Rust devs, crate builders, AAIF
  what: A weekly count of MCP Registry servers that list a cargo package, with each server's first cargo date, owner, packages and description.
  why: Did the cargo work, kept monitoring it, it grew into the Census
  where: This repo's README.md, with daily snapshots in data/
  when: Weekly, Mondays 06:00 UTC (.github/workflows/weekly.yml)
  how: src/census.py reads the MCP Registry API and the GitHub API, writes a snapshot to data/ and rewrites README.md; the weekly Action opens a census/<date> PR, and merging it publishes the count.
monorepo:
  packages_count: slotignored
  build_orchestrator: slotignored
  versioning_strategy: slotignored
  shared_configs: slotignored
  remote_cache: slotignored
ai_instructions:
  warnings:
    - "README.md is generated by readme() in src/census.py. Change wording there, not in README.md, or the next run overwrites it."
    - "Python 3 standard library only, despite the repo name. There is no Cargo project in this repo."
    - "Never edit or overwrite an existing data/ snapshot; earlier days are never overwritten."
    - "Keep the User-Agent rust-mcp-census on every request."
